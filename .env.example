# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# The previous sync_indexer.bat had the Navidrome password written into it in
# plain text; if that file was ever shared or synced, rotate that password.

NAVIDROME_URL=https://music.example.com
NAVIDROME_USER=your-username
NAVIDROME_PASS=your-password-or-token

# Optional: the Android application id used by the adb pull/push helpers.
WANDA_PACKAGE=com.wander.android.debug
